<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Dashboard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Vollbild ohne Statusleiste, für den Dashboard-Betrieb (z. B. wandmontiertes Tablet).
         Das eigentliche Ausblenden der Systemleisten passiert in MainActivity.kt per
         WindowInsetsControllerCompat: android:windowFullscreen allein wird ab Android 15
         (Edge-to-edge standardmäßig aktiv) nicht mehr zuverlässig beachtet und hinterlässt
         sonst genau die Lücke, in der sonst die Statusleiste säße. -->
    <style name="Theme.Dashboard.Fullscreen" parent="Theme.Dashboard">
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
